---
import Icon from "@/components/Icon.astro";
import { LATEST_RELEASE_URL } from "@/scripts/platform";

type InstallOption =
  | {
      id: string;
      label: string;
      kind: "command";
      command: string;
      note: string;
    }
  | { id: string; label: string; kind: "download"; note: string };

const options: InstallOption[] = [
  {
    id: "windows",
    label: "Windows",
    kind: "download",
    note: "Download the installer from the latest GitHub release and run it.",
  },
  {
    id: "arch",
    label: "Arch Linux",
    kind: "command",
    command: "paru -S goatty-bin",
    note: "From the AUR. yay -S goatty-bin works too.",
  },
  {
    id: "debian",
    label: "Ubuntu / Debian",
    kind: "command",
    command: "sudo apt install ./goatty_0.1.0-1_amd64.deb",
    note: "Ubuntu 22.04+ and Debian 12+. Get the .deb from GitHub Releases.",
  },
  {
    id: "fedora",
    label: "Fedora",
    kind: "command",
    command: "sudo dnf install ./goatty-0.1.0-1.x86_64.rpm",
    note: "Installs goatty, goattyd, the desktop launcher and shell completions.",
  },
  {
    id: "tarball",
    label: "Tarball",
    kind: "command",
    command: "tar -xzf goatty-0.1.0-x86_64-linux.tar.gz && ./install.sh",
    note: "No root needed. Installs into ~/.local/bin.",
  },
];

const firstCommand = options.find((o) => o.kind === "command");
---

<div class="install" data-install>
  <div class="install-tabs" role="tablist" aria-label="Platform">
    {options.map((opt, i) => (
      <button
        type="button"
        role="tab"
        class="install-tab"
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
        data-install-tab={opt.id}
        data-kind={opt.kind}
        data-command={opt.kind === "command" ? opt.command : undefined}
        data-note={opt.note}
      >
        {opt.label}
      </button>
    ))}
  </div>

  <div class="install-action">
    <a
      class="btn btn-primary install-download"
      href={LATEST_RELEASE_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-install-download
    >
      <Icon name="windows" size={17} />
      <span>Download the Windows installer</span>
    </a>

    <div class="install-command" data-install-command-row hidden>
      <span class="install-prompt" aria-hidden="true">❯</span>
      <code data-install-command
        >{firstCommand?.kind === "command" && firstCommand.command}</code
      >
      <button
        type="button"
        class="copy-btn"
        data-copy-btn
        aria-label="Copy install command"
      >
        <span class="copy-icon copy-icon-idle" aria-hidden="true">
          <Icon name="copy" size={15} />
        </span>
        <span class="copy-icon copy-icon-done" aria-hidden="true">
          <Icon name="check" size={15} />
        </span>
        <span data-copy-label>Copy</span>
      </button>
    </div>
  </div>

  <p class="install-note" data-install-note>{options[0].note}</p>
</div>

<script>
import { detectPlatform } from "@/scripts/platform";

function initInstall(root: HTMLElement): void {
  const tabs = Array.from(
    root.querySelectorAll<HTMLButtonElement>("[data-install-tab]"),
  );
  const download = root.querySelector<HTMLElement>("[data-install-download]");
  const commandRow = root.querySelector<HTMLElement>(
    "[data-install-command-row]",
  );
  const command = root.querySelector<HTMLElement>("[data-install-command]");
  const note = root.querySelector<HTMLElement>("[data-install-note]");
  const copyBtn = root.querySelector<HTMLButtonElement>("[data-copy-btn]");
  const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]");
  if (!download || !commandRow || !command || !note || !copyBtn || !copyLabel)
    return;

  let resetTimer = 0;
  const resetCopy = () => {
    copyBtn.classList.remove("is-copied");
    copyLabel.textContent = "Copy";
  };

  const select = (tab: HTMLButtonElement) => {
    for (const other of tabs) {
      const active = other === tab;
      other.setAttribute("aria-selected", String(active));
      other.tabIndex = active ? 0 : -1;
    }
    const isDownload = tab.dataset.kind === "download";
    download.hidden = !isDownload;
    commandRow.hidden = isDownload;
    command.textContent = tab.dataset.command ?? "";
    note.textContent = tab.dataset.note ?? "";
    resetCopy();
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (event) => {
      const step =
        event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
      if (!step) return;
      event.preventDefault();
      const next = tabs[(i + step + tabs.length) % tabs.length];
      select(next);
      next.focus();
    });
  });

  copyBtn.addEventListener("click", async () => {
    const text = command.textContent ?? "";
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      copyBtn.classList.add("is-copied");
      copyLabel.textContent = "Copied";
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(resetCopy, 1600);
    } catch {
      copyLabel.textContent = "Select and copy";
    }
  });

  // Start on the visitor's platform: Windows, or Arch for everyone else.
  const preferred = detectPlatform() === "windows" ? "windows" : "arch";
  const initial = tabs.find((t) => t.dataset.installTab === preferred);
  if (initial) select(initial);
}

for (const root of document.querySelectorAll<HTMLElement>("[data-install]")) {
  initInstall(root);
}
</script>

<style>
.install {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 100%;
  max-width: 680px;
}

.install-tabs {
  display: flex;
  gap: 26px;
  border-bottom: 1px solid var(--border-hairline);
  overflow-x: auto;
  scrollbar-width: none;
}

.install-tabs::-webkit-scrollbar {
  display: none;
}

.install-tab {
  appearance: none;
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  padding: 0 0 14px;
  flex-shrink: 0;
  font-family: var(--font-sans);
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--ink-muted);
  white-space: nowrap;
  cursor: pointer;
  transition:
    color 140ms ease,
    border-color 140ms ease;
}

.install-tab:hover {
  color: var(--ink-primary);
}

.install-tab[aria-selected="true"] {
  color: var(--ink-primary);
  border-bottom-color: var(--accent-orange);
}

.install-action {
  min-height: 56px;
  display: flex;
  align-items: center;
}

.install-download[hidden],
.install-command[hidden] {
  display: none;
}

/* The command sits in a pill, like every other interactive element */
.install-command {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-height: 56px;
  padding: 6px 6px 6px 22px;
  border-radius: var(--radius-pill);
  border: 1px solid var(--border-strong);
  background-color: var(--bg-surface);
}

.install-prompt {
  color: var(--accent-orange);
  font-family: var(--font-mono);
  flex-shrink: 0;
}

.install-command code {
  flex: 1;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
  font-family: var(--font-mono);
  font-size: 0.9rem;
  color: var(--ink-primary);
  white-space: nowrap;
}

.copy-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  flex-shrink: 0;
  height: 42px;
  padding-inline: 14px 18px;
  border-radius: var(--radius-pill);
  border: 1px solid transparent;
  background-color: rgba(255, 255, 255, 0.07);
  color: var(--ink-primary);
  font-family: var(--font-sans);
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    background-color 140ms ease,
    color 140ms ease;
}

.copy-btn:hover {
  background-color: rgba(255, 255, 255, 0.13);
}

.copy-icon {
  display: inline-flex;
}

.copy-icon-done,
.copy-btn.is-copied .copy-icon-idle {
  display: none;
}

.copy-btn.is-copied .copy-icon-done {
  display: inline-flex;
}

.copy-btn.is-copied {
  color: var(--accent-orange);
}

.install-note {
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--ink-muted);
}

@media (max-width: 600px) {
  .install-tabs {
    gap: 20px;
  }

  .install-command code {
    font-size: 0.8rem;
  }

  .copy-btn span[data-copy-label] {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  .copy-btn {
    width: 42px;
    padding: 0;
    justify-content: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .install-tab,
  .copy-btn {
    transition: none;
  }
}
</style>
