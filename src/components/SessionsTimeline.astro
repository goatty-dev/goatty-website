---
/**
 * Replaces the old boxed multiplexer section.
 * A two-track timeline: the goatty window comes and goes, the session in
 * goattyd runs straight through. The steps are a real sequence in time, so
 * they carry times rather than decorative numbers.
 */

interface Step {
  time: string;
  window: "open" | "closed";
  session: "running" | "done";
  title: string;
  body: string;
}

const steps: Step[] = [
  {
    time: "09:10",
    window: "open",
    session: "running",
    title: "Start an agent on your dev box",
    body: "From your laptop, open a tab on the server and hand Claude Code a long refactor.",
  },
  {
    time: "12:30",
    window: "closed",
    session: "running",
    title: "Close the laptop",
    body: "The window is gone. The session keeps running on the server, and so does the agent.",
  },
  {
    time: "13:15",
    window: "open",
    session: "running",
    title: "Pick it up from your desktop",
    body: "Attach over SSH or Tailscale and land in the same tab, scrollback and all.",
  },
  {
    time: "14:05",
    window: "open",
    session: "done",
    title: "See that it finished",
    body: "The tab shows a check and your desktop shows a notification. Nothing was lost.",
  },
];

const details = [
  {
    title: "SSH or Tailscale",
    body: "Add hosts from your ~/.ssh/config, or pair computers on your tailnet without SSH. Scrollback loads as you need it, so slow Wi-Fi stays usable.",
  },
  {
    title: "The same shell on every host",
    body: "goatty copies your managed shell, prompt and plugins to the machines you connect to, so each one feels like your own from the first prompt.",
  },
  {
    title: "Agents tell you when they need you",
    body: "Claude Code, Codex, OpenCode and Antigravity show in their tab whether they are working, waiting for permission or done.",
  },
];
---

<section id="sessions" class="sessions">
  <div class="container">
    <header class="ss-head">
      <h2>Close the window. The work keeps running.</h2>
      <p>
        Every machine runs <code>goattyd</code>, a small daemon that owns your
        shell sessions. The window only shows them, so programs and coding
        agents carry on when it closes, and any computer can pick them up again.
      </p>
    </header>

    <div class="ss-legend" aria-hidden="true">
      <span class="legend-item">
        <span class="legend-swatch legend-window"></span>
        Your goatty window
      </span>
      <span class="legend-item">
        <span class="legend-swatch legend-session"></span>
        The session in goattyd
      </span>
    </div>

    <ol class="timeline">
      {steps.map((step) => (
        <li
          class="tl-step"
          data-window={step.window}
          data-session={step.session}
        >
          <div class="tl-tracks" aria-hidden="true">
            <span class="tl-track tl-track-window" />
            <span class="tl-track tl-track-session" />
          </div>
          <div class="tl-copy">
            <time class="tl-time">{step.time}</time>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </li>
      ))}
    </ol>

    <ul class="ss-details">
      {details.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
.sessions {
  padding-block: clamp(56px, 7vw, 100px);
}

.ss-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 20px 64px;
  align-items: end;
  margin-bottom: clamp(48px, 6vw, 72px);
}

.ss-head h2 {
  font-size: clamp(2rem, 4.4vw, 3.25rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.02;
  max-width: 16ch;
}

.ss-head p {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--ink-secondary);
  max-width: 46ch;
}

.ss-head code {
  font-family: var(--font-mono);
  font-size: 0.9em;
  color: var(--ink-primary);
}

/* Legend */
.ss-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 28px;
  margin-bottom: 22px;
  font-size: 0.8125rem;
  color: var(--ink-muted);
}

.legend-item {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.legend-swatch {
  width: 22px;
  height: 3px;
  border-radius: 2px;
}

.legend-window {
  background-color: var(--ink-secondary);
}

.legend-session {
  background-color: var(--accent-orange);
}

/* Timeline: each step owns its slice of both tracks */
.timeline {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.tl-step {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.tl-tracks {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding-block: 4px 30px;
}

.tl-track {
  position: relative;
  display: block;
  height: 3px;
}

.tl-track-window {
  background-color: var(--ink-secondary);
}

.tl-track-session {
  background-color: var(--accent-orange);
}

/* Closed window: the track breaks off and leaves a faint dashed gap */
.tl-step[data-window="closed"] .tl-track-window {
  background: repeating-linear-gradient(
    to right,
    var(--border-strong) 0 4px,
    transparent 4px 10px
  );
}

/* Finished session: a done marker, then the idle session continues dimmed */
.tl-step[data-session="done"] .tl-track-session {
  background-color: rgba(255, 90, 0, 0.28);
}

.tl-step[data-session="done"] .tl-track-session::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 50%;
  width: 13px;
  height: 13px;
  border-radius: 999px;
  background-color: var(--accent-orange);
  border: 3px solid var(--bg-canvas);
  transform: translate(-50%, -50%);
}

/* Event tick at the start of each step */
.tl-tracks::before {
  content: "";
  position: absolute;
  left: 0;
  top: -6px;
  bottom: 14px;
  width: 1px;
  background-color: var(--border-strong);
}

.tl-copy {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-right: 28px;
}

.tl-time {
  font-family: var(--font-pixel);
  font-size: 0.8125rem;
  color: var(--accent-orange);
}

.tl-copy h3 {
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.3;
}

.tl-copy p {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--ink-muted);
}

/* Details under the timeline */
.ss-details {
  list-style: none;
  margin: clamp(56px, 7vw, 88px) 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32px 48px;
}

.ss-details h3 {
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: -0.015em;
  margin-bottom: 8px;
}

.ss-details p {
  font-size: 0.9rem;
  line-height: 1.6;
  color: var(--ink-muted);
}

@media (max-width: 900px) {
  .ss-head {
    grid-template-columns: minmax(0, 1fr);
  }

  .ss-details {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
}

/* Small screens: the timeline turns vertical, tracks run down the left */
@media (max-width: 720px) {
  .timeline {
    grid-template-columns: minmax(0, 1fr);
  }

  .tl-step {
    flex-direction: row;
    gap: 18px;
  }

  .tl-tracks {
    flex-direction: row;
    gap: 8px;
    padding-block: 0;
    padding-left: 2px;
  }

  .tl-tracks::before {
    display: none;
  }

  .tl-track {
    width: 3px;
    height: auto;
  }

  .tl-step[data-window="closed"] .tl-track-window {
    background: repeating-linear-gradient(
      to bottom,
      var(--border-strong) 0 4px,
      transparent 4px 10px
    );
  }

  .tl-step[data-session="done"] .tl-track-session::before {
    left: 50%;
    top: 0;
    transform: translate(-50%, 0);
  }

  .tl-copy {
    padding: 0 0 30px;
  }
}
</style>
