---
import type { SceneName } from "@/scripts/dither3d";

interface Props {
  scene: SceneName;
  title: string;
  description: string;
}

const { scene, title, description } = Astro.props;
---

<article class="dither-card">
  <div class="dither-stage">
    <canvas data-dither-scene={scene} aria-hidden="true"></canvas>
  </div>
  <div class="dither-caption">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
.dither-card {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.dither-stage {
  aspect-ratio: 16 / 10;
  width: 100%;
  background-color: var(--bg-surface);
  border: 1px solid var(--border-hairline);
  border-radius: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    border-color 160ms ease,
    background-color 160ms ease;
}

.dither-card:hover .dither-stage {
  border-color: var(--border-strong);
  background-color: #111114;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
}

.dither-caption {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

h3 {
  font-family: var(--font-sans);
  font-size: 1.125rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--ink-primary);
  line-height: 1.3;
}

p {
  font-size: 0.9375rem;
  line-height: 1.55;
  color: var(--ink-muted);
  max-width: 52ch;
}

@media (prefers-reduced-motion: reduce) {
  .dither-stage {
    transition: none;
  }
}
</style>
