---
import BuiltInList from "@/components/BuiltInList.astro";
import GoattyLogo from "@/components/GoattyLogo.astro";
import HeroTerminal from "@/components/HeroTerminal.astro";
import Icon from "@/components/Icon.astro";
import InstallBar from "@/components/InstallBar.astro";
import PluginConfigDemo from "@/components/PluginConfigDemo.astro";
import SessionsTimeline from "@/components/SessionsTimeline.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { RELEASES_URL, REPO_URL } from "@/scripts/platform";
---

<BaseLayout
  title="goatty — A GPU terminal for Linux and Windows that's ready when you open it"
  description="goatty is a fast GPU terminal for Linux and Windows. Autosuggestions, syntax highlighting, fuzzy search and a prompt work from the first command, every setting is in a visual GUI, and sessions keep running after you close the window."
>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="nav-wrap">
    <header class="floating-pill" data-floating-pill>
      <a href="/" class="brand-link" aria-label="goatty home">
        <GoattyLogo size={24} />
      </a>

      <nav class="pill-nav" aria-label="Primary">
        <a href="#built-in">Features</a>
        <a href="#sessions">Sessions</a>
        <a href="#plugins">Plugins</a>
        <a href="/docs/getting-started">Docs</a>
      </nav>

      <div class="pill-actions">
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="pill-icon"
          aria-label="goatty on GitHub"
        >
          <Icon name="github" size={18} />
        </a>
        <a href="#install" class="btn btn-primary btn-small">
          <Icon name="download" size={15} />
          <span>Download</span>
        </a>
      </div>
    </header>
  </div>

  <main id="main">
    <section class="hero">
      <div class="container">
        <div class="hero-top">
          <h1>
            <span class="h1-line">A terminal that's ready</span>{" "}
            <span class="h1-line">when you open it.</span>
          </h1>

          <div class="hero-row">
            <p class="hero-lead">
              A fast GPU terminal for Linux and Windows. Your shell, prompt and
              plugins come set up, with no dotfiles to write.
            </p>

            <div class="hero-actions">
              <a href="#install" class="btn btn-primary" data-platform-cta>
                <span class="cta-variant" data-cta="default">
                  <Icon name="download" size={17} />
                  <span>Get goatty</span>
                </span>
                <span class="cta-variant" data-cta="windows" hidden>
                  <Icon name="windows" size={17} />
                  <span>Install on Windows</span>
                </span>
                <span class="cta-variant" data-cta="linux" hidden>
                  <Icon name="linux" size={17} />
                  <span>Install on Linux</span>
                </span>
              </a>
              <a href="/docs/getting-started" class="btn btn-secondary">
                <Icon name="book" size={17} />
                <span>Read the docs</span>
              </a>
            </div>
          </div>
        </div>

        <div class="hero-demo">
          <HeroTerminal />
        </div>
      </div>
    </section>

    <BuiltInList />
    <SessionsTimeline />
    <PluginConfigDemo />

    <section id="install" class="closing">
      <div class="container">
        <div class="wordmark-stage">
          <canvas data-dither-wordmark aria-hidden="true"></canvas>
        </div>

        <div class="closing-grid">
          <div class="closing-copy">
            <h2>Get goatty</h2>
            <p>
              One command on Linux and Windows, no root or administrator rights
              needed, plus packages for the major Linux distributions. Your
              existing shell and dotfiles stay exactly as they are.
            </p>
            <p class="closing-links">
              <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
                All downloads and release notes
              </a>
              <a href="/docs/getting-started">Getting started guide</a>
            </p>
          </div>

          <InstallBar />
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <GoattyLogo size={22} />
        <span class="footer-note">
          A GPU terminal for Linux and Windows. macOS is planned.
        </span>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <a href="/docs/getting-started">Docs</a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
          Releases
        </a>
        <a
          href={`${REPO_URL}/issues`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Issues
        </a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<script>
import { initDitherWordmark } from "@/scripts/dither3d";
import { detectPlatform } from "@/scripts/platform";

initDitherWordmark();

// Point the hero button at the visitor's platform.
const cta = document.querySelector<HTMLAnchorElement>("[data-platform-cta]");
if (cta) {
  const platform = detectPlatform();
  const variant =
    platform === "windows" || platform === "linux" ? platform : "default";
  for (const el of cta.querySelectorAll<HTMLElement>("[data-cta]")) {
    el.hidden = el.dataset.cta !== variant;
  }
}

// Lift the navbar off the page once it floats over content.
const floatingPill = document.querySelector<HTMLElement>(
  "[data-floating-pill]",
);
if (floatingPill) {
  const syncNavScroll = () => {
    floatingPill.classList.toggle("is-scrolled", window.scrollY > 12);
  };
  syncNavScroll();
  window.addEventListener("scroll", syncNavScroll, { passive: true });
}
</script>

<style>
.skip-link {
  position: absolute;
  left: 16px;
  top: -60px;
  z-index: 60;
  padding: 10px 16px;
  border-radius: var(--radius-pill);
  background-color: var(--ink-primary);
  color: var(--bg-canvas);
  font-weight: 600;
}

.skip-link:focus {
  top: 16px;
}

/* Floating pill navbar */
.nav-wrap {
  position: sticky;
  top: 16px;
  z-index: 50;
  padding-inline: var(--gutter);
  pointer-events: none;
}

.floating-pill {
  pointer-events: auto;
  max-width: 820px;
  margin-inline: auto;
  padding: 6px 6px 6px 20px;
  border-radius: var(--radius-pill);
  background-color: rgba(16, 16, 20, 0.82);
  backdrop-filter: blur(14px) saturate(140%);
  border: 1px solid #24242b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.floating-pill.is-scrolled {
  background-color: rgba(18, 18, 23, 0.9);
  border-color: var(--border-strong);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.6);
}

.brand-link {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.pill-nav {
  display: flex;
  align-items: center;
  gap: 4px;
}

.pill-nav a {
  padding: 8px 12px;
  border-radius: var(--radius-pill);
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--ink-muted);
  transition:
    color 140ms ease,
    background-color 140ms ease;
}

.pill-nav a:hover {
  color: var(--ink-primary);
  background-color: rgba(255, 255, 255, 0.05);
}

.pill-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.pill-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: var(--radius-pill);
  color: var(--ink-muted);
  transition:
    color 140ms ease,
    background-color 140ms ease;
}

.pill-icon:hover {
  color: var(--ink-primary);
  background-color: rgba(255, 255, 255, 0.06);
}

/* Hero */
.hero {
  padding-top: clamp(56px, 7vw, 96px);
}

/*
 * One left edge for everything: the headline, the lead and the terminal all
 * start on the container line. The headline breaks into two fixed lines on
 * wide screens, so its shape never depends on the viewport.
 */
.hero-top {
  display: flex;
  flex-direction: column;
  gap: clamp(28px, 3.5vw, 40px);
}

h1 {
  font-size: clamp(2.75rem, 7vw, 5.5rem);
  font-weight: 600;
  letter-spacing: -0.05em;
  line-height: 0.98;
  color: var(--ink-primary);
  text-wrap: balance;
  /* Optical alignment: pull the A's side bearing back onto the edge */
  margin-left: -0.04em;
}

.h1-line {
  display: block;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 24px 48px;
}

.hero-lead {
  font-size: 1.1875rem;
  line-height: 1.55;
  color: var(--ink-secondary);
  max-width: 56ch;
  text-wrap: balance;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.cta-variant {
  display: inline-flex;
  align-items: center;
  gap: 9px;
}

.cta-variant[hidden] {
  display: none;
}

.hero-demo {
  margin-top: clamp(40px, 5vw, 64px);
}

/* Closing + install */
.closing {
  padding-block: clamp(24px, 4vw, 48px) clamp(80px, 10vw, 128px);
}

.wordmark-stage {
  width: 100%;
  aspect-ratio: 18 / 5;
  min-height: 140px;
  margin-bottom: clamp(32px, 5vw, 56px);
}

.wordmark-stage canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
}

.closing-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
  gap: 40px 64px;
  align-items: start;
}

.closing-copy {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.closing-copy h2 {
  font-size: clamp(2rem, 4.4vw, 3.25rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.02;
}

.closing-copy p {
  font-size: 1.0625rem;
  line-height: 1.6;
  color: var(--ink-secondary);
  max-width: 40ch;
}

.closing-links {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 4px;
}

.closing-links a {
  width: fit-content;
  font-size: 0.9375rem;
  color: var(--ink-primary);
  text-decoration: underline;
  text-decoration-color: var(--accent-orange);
  text-underline-offset: 4px;
}

.closing-links a:hover {
  color: var(--accent-orange);
}

/* Footer */
.site-footer {
  padding-block: 32px 48px;
  border-top: 1px solid var(--border-hairline);
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.footer-brand {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-note {
  font-size: 0.875rem;
  color: var(--ink-muted);
}

.footer-links {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
}

.footer-links a {
  font-size: 0.875rem;
  color: var(--ink-muted);
  transition: color 140ms ease;
}

.footer-links a:hover {
  color: var(--ink-primary);
}

@media (max-width: 900px) {
  .closing-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 640px) {
  .h1-line {
    display: inline;
  }
}

@media (max-width: 680px) {
  .pill-nav {
    display: none;
  }

  .floating-pill {
    padding-left: 16px;
  }

  .wordmark-stage {
    aspect-ratio: 12 / 5;
  }
}

@media (prefers-reduced-motion: reduce) {
  .floating-pill,
  .pill-nav a,
  .pill-icon,
  .footer-links a {
    transition: none;
  }
}
</style>
