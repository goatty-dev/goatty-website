---
import DitherCard from "@/components/DitherCard.astro";
import GoattyLogo from "@/components/GoattyLogo.astro";
import Icon, { type IconName } from "@/components/Icon.astro";
import InstallBar from "@/components/InstallBar.astro";
import MultiplexerSection from "@/components/MultiplexerSection.astro";
import PluginSettingsSection from "@/components/PluginSettingsSection.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

interface StackItem {
  icon: IconName;
  area: string;
  capability: string;
  replacesSetup: string;
}

const stackLayers: StackItem[] = [
  {
    icon: "terminal",
    area: "Shell layer",
    capability: "Managed Zsh out of the box",
    replacesSetup: "No oh-my-zsh boilerplate or ~/.zshrc edits",
  },
  {
    icon: "control-slider",
    area: "Settings",
    capability: "Visual GPUI controls",
    replacesSetup: "No config syntax, TOML, or Lua to memorize",
  },
  {
    icon: "circle-spark",
    area: "Prompt & search",
    capability: "Starship & fzf-tab pre-wired",
    replacesSetup: "No manual plugin sourcing or theme scripts",
  },
  {
    icon: "cpu",
    area: "Background agents",
    capability: "Persistent goattyd sessions",
    replacesSetup: "No tmux or screen wrappers just to keep jobs alive",
  },
  {
    icon: "server-connection",
    area: "Remote hosts",
    capability: "Tailscale pairing & SSH sync",
    replacesSetup: "No copying dotfiles to every server you touch",
  },
  {
    icon: "shortcut-square",
    area: "Shortcuts & PATH",
    capability: "Desktop keys & GUI PATH toggles",
    replacesSetup: "No hand-edited PATH exports or cryptic keycodes",
  },
];
---

<BaseLayout
  title="goatty — GPU Terminal with Built-In Multiplexer & GUI Settings"
  description="A fast GPU-rendered terminal in Rust and GPUI with a built-in predictive multiplexer, visual GUI settings for every tool and plugin, and automatic host sync."
>
  <div class="nav-wrap">
    <header class="floating-pill" data-floating-pill>
      <a href="/" class="brand-link" aria-label="goatty home">
        <GoattyLogo size={24} />
      </a>

      <nav class="pill-nav" aria-label="Primary">
        <a href="#features">Features</a>
        <a href="#replaces">Stack</a>
        <a href="#multiplexer">Multiplexer</a>
        <a href="#plugins">Plugins</a>
        <a href="/docs/getting-started">Docs</a>
      </nav>

      <a
        href="https://github.com/goatty-dev/goatty"
        target="_blank"
        rel="noopener noreferrer"
        class="pill-cta"
      >
        <Icon name="github" size={15} />
        <span>GitHub</span>
      </a>
    </header>
  </div>

  <main>
    <section id="install" class="hero">
      <div class="container hero-inner">
        <p class="hero-kicker pixel-text">
          Linux GPU terminal — macOS and Windows planned
        </p>
        <h1>A working shell from your first command.</h1>
        <p class="hero-lead">
          A Linux terminal you can use from day one — zero-config managed Zsh,
          visual GPUI settings, and persistent sessions that outlive your
          window.
        </p>

        <div class="hero-install">
          <InstallBar />
          <div class="hero-links">
            <a
              href="https://github.com/goatty-dev/goatty/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <Icon name="download" size={16} />
              <span>Download release</span>
            </a>
            <a href="/docs/getting-started" class="btn btn-secondary">
              <Icon name="book" size={16} />
              <span>Read the docs</span>
            </a>
            <a
              href="https://github.com/goatty-dev/goatty"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-secondary"
            >
              <Icon name="github" size={16} />
              <span>View on GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="showcase">
      <div class="container">
        <div class="section-head" data-reveal>
          <h2>Zero configuration required</h2>
        </div>

        <div class="showcase-grid">
          <div data-reveal data-reveal-delay="0">
            <DitherCard
              scene="zsh-layers"
              title="Managed .zsh out of the box"
              description="Inline suggestions, syntax checks, Starship, and fzf history ready on first launch."
            />
          </div>
          <div data-reveal data-reveal-delay="80">
            <DitherCard
              scene="gui-plugins"
              title="Every control in GPUI"
              description="Configure themes, fonts, PATH, aliases, and plugins visually without touching dotfiles."
            />
          </div>
          <div data-reveal data-reveal-delay="160">
            <DitherCard
              scene="key-matrix"
              title="Desktop copy, paste, and search"
              description="Ctrl+C on selection, Ctrl+V paste, editor-style find, and GUI keybind editing."
            />
          </div>
          <div data-reveal data-reveal-delay="240">
            <DitherCard
              scene="ssh-bridge"
              title="Portable across machines"
              description="Connect via Tailscale or SSH and keep the same prompt, tools, and active daemon sessions."
            />
          </div>
        </div>
      </div>
    </section>

    <section id="replaces" class="replaces" data-reveal>
      <div class="container replaces-grid">
        <div class="replaces-intro">
          <h2>One unified stack, zero dotfile glue</h2>
          <p>
            Prompt, plugins, and session persistence ship together and work on
            first launch.
          </p>
          <p class="replaces-note">
            Similar in spirit to <strong>Rex Terminal</strong> by Superlogical,
            built beginner-first with visual theming.
          </p>
        </div>

        <ul class="stack-grid">
          {stackLayers.map((item) => (
            <li class="stack-item">
              <p class="stack-label pixel-text">{item.area}</p>
              <div class="stack-head">
                <Icon name={item.icon} size={17} class="stack-icon" />
                <h3>{item.capability}</h3>
              </div>
              <p class="stack-desc">{item.replacesSetup}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <div data-reveal>
      <MultiplexerSection />
    </div>

    <div data-reveal>
      <PluginSettingsSection />
    </div>

    <section class="closing" data-reveal>
      <div class="container closing-inner">
        <div class="wordmark-stage">
          <canvas data-dither-wordmark aria-hidden="true"></canvas>
        </div>

        <div class="closing-copy">
          <h2>Ready when you open it.</h2>
          <p>
            Linux packages ready today, with native macOS and Windows builds
            planned.
          </p>
          <div class="closing-actions">
            <a href="#install" class="btn btn-primary">
              <Icon name="download" size={16} />
              <span>Install on Linux</span>
            </a>
            <a href="/docs/getting-started" class="btn btn-secondary">
              <Icon name="book" size={16} />
              <span>Read the docs</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <GoattyLogo size={22} />
        <span class="footer-note">
          GPU terminal for Linux. macOS and Windows planned.
        </span>
      </div>

      <nav class="footer-links" aria-label="Footer">
        <a href="/docs/getting-started">Docs</a>
        <a
          href="https://github.com/goatty-dev/goatty"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
        <a
          href="https://github.com/goatty-dev/goatty/releases"
          target="_blank"
          rel="noopener noreferrer"
        >
          Releases
        </a>
        <a
          href="https://github.com/goatty-dev/goatty/issues"
          target="_blank"
          rel="noopener noreferrer"
        >
          Issues
        </a>
      </nav>
    </div>
  </footer>
</BaseLayout>

<script>
import { initDitherCanvases, initDitherWordmark } from "@/scripts/dither3d";

initDitherCanvases();
initDitherWordmark();

// Subtle elevation cue on floating pill once scrolled past top
const floatingPill = document.querySelector<HTMLElement>(
  "[data-floating-pill]",
);
if (floatingPill) {
  const syncNavScroll = () => {
    floatingPill.classList.toggle("is-scrolled", window.scrollY > 12);
  };
  syncNavScroll();
  window.addEventListener("scroll", syncNavScroll, { passive: true });
}

// Smooth scroll reveal for below-the-fold sections
const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
const reducedMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)",
).matches;

if (reducedMotion || !("IntersectionObserver" in window)) {
  for (const el of revealEls) {
    el.classList.add("is-visible");
  }
} else {
  const revealObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const el = entry.target as HTMLElement;
        const delay = el.dataset.revealDelay;
        if (delay) {
          el.style.transitionDelay = `${delay}ms`;
        }
        el.classList.add("is-visible");
        revealObserver.unobserve(el);
      }
    },
    { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
  );

  for (const el of revealEls) {
    revealObserver.observe(el);
  }
}
</script>

<style>
/* Scroll reveal animation */
[data-reveal] {
  opacity: 0;
  transform: translateY(18px);
  transition:
    opacity 520ms cubic-bezier(0.22, 1, 0.36, 1),
    transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
}

[data-reveal].is-visible {
  opacity: 1;
  transform: translateY(0);
}

/* Floating Pill Navbar with subtle scroll elevation */
.nav-wrap {
  position: sticky;
  top: 16px;
  z-index: 50;
  padding-inline: var(--gutter);
  pointer-events: none;
}

.floating-pill {
  pointer-events: auto;
  max-width: 780px;
  margin-inline: auto;
  padding: 7px 7px 7px 18px;
  border-radius: 999px;
  background-color: #101014;
  border: 1px solid #24242b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition:
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.floating-pill.is-scrolled {
  background-color: #121217;
  border-color: #32323c;
  box-shadow:
    0 12px 30px rgba(0, 0, 0, 0.7),
    0 0 0 1px rgba(255, 255, 255, 0.03);
}

.brand-link {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
}

.pill-nav {
  display: flex;
  align-items: center;
  gap: 22px;
}

.pill-nav a {
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--ink-muted);
  transition: color 140ms ease;
}

.pill-nav a:hover {
  color: var(--ink-primary);
}

.pill-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  height: 36px;
  padding-inline: 15px;
  border-radius: 999px;
  background-color: var(--ink-primary);
  color: var(--bg-canvas);
  font-size: 0.875rem;
  font-weight: 500;
  flex-shrink: 0;
  transition:
    background-color 140ms ease,
    color 140ms ease;
}

.pill-cta:hover {
  background-color: var(--accent-orange);
  color: var(--bg-canvas);
}

/* Hero + Install */
.hero {
  padding-top: clamp(56px, 8vw, 92px);
  padding-bottom: clamp(64px, 8vw, 104px);
}

.hero-inner {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-kicker {
  font-size: 0.8125rem;
  color: var(--accent-orange);
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(2.35rem, 5.2vw, 3.85rem);
  font-weight: 600;
  letter-spacing: -0.035em;
  line-height: 1.05;
  max-width: 15ch;
  color: var(--ink-primary);
}

.hero-lead {
  margin-top: 20px;
  font-size: clamp(1rem, 1.35vw, 1.125rem);
  line-height: 1.6;
  color: var(--ink-secondary);
  max-width: 58ch;
}

.hero-install {
  margin-top: 34px;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 22px;
}

.hero-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* Showcase 2x2 */
.showcase {
  padding-bottom: clamp(72px, 9vw, 120px);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px 24px;
  margin-bottom: 28px;
}

.section-head h2 {
  font-size: clamp(1.375rem, 2.4vw, 1.75rem);
  font-weight: 600;
  letter-spacing: -0.025em;
  color: var(--ink-primary);
}

.showcase-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 44px 28px;
}

/* Unified stack section */
.replaces {
  padding-bottom: clamp(72px, 9vw, 120px);
}

.replaces-grid {
  display: grid;
  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  gap: 36px 56px;
  align-items: start;
}

.replaces-intro {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.replaces-intro h2 {
  font-size: clamp(1.5rem, 2.6vw, 2rem);
  font-weight: 600;
  letter-spacing: -0.028em;
  line-height: 1.16;
  max-width: 18ch;
}

.replaces-intro p {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--ink-muted);
  max-width: 44ch;
}

.replaces-note {
  color: var(--ink-secondary);
}

.replaces-note strong {
  color: var(--ink-primary);
  font-weight: 500;
}

.stack-grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px 32px;
}

.stack-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-top: 14px;
  border-top: 1px solid var(--border-hairline);
}

.stack-label {
  font-size: 0.72rem;
  color: var(--ink-muted);
}

.stack-head {
  display: flex;
  align-items: center;
  gap: 8px;
}

.stack-icon {
  color: var(--accent-orange);
}

.stack-head h3 {
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1.3;
  color: var(--ink-primary);
}

.stack-desc {
  font-size: 0.875rem;
  line-height: 1.5;
  color: var(--ink-muted);
}

/* Bottom Dithered Font Artwork + Closing CTA */
.closing {
  padding-bottom: clamp(64px, 8vw, 108px);
}

.closing-inner {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.wordmark-stage {
  width: 100%;
  aspect-ratio: 18 / 5;
  min-height: 140px;
  background-color: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wordmark-stage canvas {
  width: 100%;
  height: 100%;
  display: block;
  image-rendering: pixelated;
}

.closing-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12px;
}

.closing-copy h2 {
  font-size: clamp(1.5rem, 2.8vw, 2.125rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
}

.closing-copy p {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--ink-muted);
  max-width: 54ch;
}

.closing-actions {
  margin-top: 8px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* Footer */
.site-footer {
  padding-block: 36px 48px;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}

.footer-brand {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16px;
}

.footer-note {
  font-size: 0.875rem;
  color: var(--ink-muted);
}

.footer-links {
  display: flex;
  align-items: center;
  gap: 24px;
}

.footer-links a {
  font-size: 0.875rem;
  color: var(--ink-muted);
  transition: color 140ms ease;
}

.footer-links a:hover {
  color: var(--ink-primary);
}

@media (max-width: 860px) {
  .replaces-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}

@media (max-width: 720px) {
  .showcase-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }
}

@media (max-width: 600px) {
  .pill-nav a:nth-child(2),
  .pill-nav a:nth-child(3),
  .pill-nav a:nth-child(4) {
    display: none;
  }

  .pill-nav {
    gap: 14px;
  }

  .stack-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .wordmark-stage {
    aspect-ratio: 12 / 5;
  }
}

@media (max-width: 430px) {
  .pill-nav a:not(:last-child) {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal] {
    opacity: 1;
    transform: none;
    transition: none;
  }

  .floating-pill,
  .pill-nav a,
  .pill-cta,
  .footer-links a {
    transition: none;
  }
}
</style>
